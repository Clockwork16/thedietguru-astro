---
import Layout from '../layouts/Layout.astro';

const guruProfile = {
  name: 'The Diet Guru, CHHC, CNC',
  role: 'Lead Holistic Nutritionist & Wellness Strategist',
  desc: 'Certified in holistic health and nutritional consulting, dedicated to empowering your vitality through whole-food nourishment, mindful living, and sustainable habits.',
  image: '/images/guru-profile.jpg',
};

const pillars = [
  {
    icon: '💓',
    title: 'Metabolic Vitality',
    desc: 'Supporting balanced energy and sustained vitality through whole-food nutrient precision.',
  },
  {
    icon: '🌱',
    title: 'Gut Health & Flora',
    desc: 'Nurturing the microbiome as the central foundation for daily digestion, immunity, and clarity.',
  },
  {
    icon: '🥑',
    title: 'Longevity & Real Food',
    desc: 'Harnessing the power of clean, natural nutrition to enhance healthspan and everyday energy.',
  },
];
---

<Layout
  title="Our Mission"
  description="The Diet Guru: evidence-based nutrition and whole-food wellness. Meet the Guru, learn our story, and explore simple, sustainable eating habits."
  keywords={['about diet guru', 'whole food nutrition', 'wellness mission', 'healthy lifestyle', 'clockwork apps']}
  canonicalPath="/about"
>
  <main class="about-page">
    <!-- Hero -->
    <section class="about-hero">
      <div class="hero-inner">
        <span class="hero-badge" aria-hidden="true">🌱 Evidence-Based Guidance</span>
        <h1 class="hero-title">Food is Medicine</h1>
        <p class="hero-subtitle">
          Bridging the gap between nutritional science and daily living
          through clear, evidence-based guidance.
        </p>
      </div>
    </section>

    <div class="about-inner">
      <!-- Mission -->
      <section class="mission-section">
        <blockquote class="mission-quote">
          "To make whole-food nutrition and evidence-based wellness accessible to all, empowering individuals
          to thrive through simple, sustainable lifestyle habits."
        </blockquote>
      </section>

      <!-- Core Pillars -->
      <section class="pillars-section">
        <h2 class="section-title">Core Pillars</h2>
        <div class="pillars-grid">
          {pillars.map(pillar => (
            <div class="pillar-card">
              <span class="pillar-icon" aria-hidden="true">{pillar.icon}</span>
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-desc">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- The Guru Profile -->
      <section class="guru-section">
        <div class="guru-header">
          <h2 class="section-title">Meet The Guru</h2>
          <p class="guru-subtitle">Rooted in real-food principles and whole-body vitality.</p>
        </div>
        <div class="guru-card-container">
          <div class="guru-card">
            <div class="guru-image-box">
              <img src={guruProfile.image} alt={guruProfile.name} class="guru-avatar-img" />
            </div>
            <div class="guru-details">
              <h3 class="guru-name">{guruProfile.name}</h3>
              <p class="guru-role">{guruProfile.role}</p>
              <p class="guru-desc">{guruProfile.desc}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Story -->
      <section class="story-section">
        <h2 class="section-title">Our Story</h2>
        <div class="story-content">
          <p>
            The Diet Guru was born from a simple realization: the internet is filled with diet fads and noisy trends,
            but starving for grounded truth. We saw a world where health was being marketed, not nurtured.
          </p>
          <p>
            In partnership with <strong>Clockwork Apps</strong>, we built a platform that translates the
            science of nutrition into practical, delicious everyday food. We don't believe in restrictive
            "fad diets." We believe in nutrient-dense real foods, mindful habits, and long-term vitality.
          </p>
          <div class="story-footer">
            <p>
              <em>The Diet Guru is a wellness technology initiative by
              <a href="https://clockworkapps.com">Clockwork Apps</a>. We are committed to transparency,
              authenticity, and sustainable wellness education.</em>
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Hero */
  .about-hero {
    background: linear-gradient(160deg, #e6ede3 0%, #cddbc7 50%, #abc09f 100%);
    padding: 5rem 1.5rem 4rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 42rem;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(255,255,255,0.7);
    border-radius: 24px;
    font-size: 0.813rem;
    font-weight: 600;
    color: #344f2e;
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #1A1A1A;
    margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: #4f4f4f;
    margin: 0;
    line-height: 1.7;
  }

  .about-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1A1A1A;
    margin: 0 0 1.5rem;
    text-align: center;
  }

  /* Mission */
  .mission-section {
    padding: 4rem 0;
    text-align: center;
  }
  .mission-quote {
    font-size: 1.25rem;
    font-style: italic;
    color: #4f4f4f;
    line-height: 1.8;
    border: none;
    padding: 2rem;
    margin: 0;
    background: #fff;
    border-radius: 20px;
    border-left: 6px solid #4F7942;
    box-shadow: 0 4px 16px rgba(79, 121, 66, 0.08);
  }

  /* Pillars */
  .pillars-section {
    padding: 0 0 4rem;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .pillars-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .pillar-card {
    padding: 2rem;
    background: #fff;
    border-radius: 16px;
    border: 2px solid #e6ede3;
    text-align: center;
    transition: all 0.3s;
  }
  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(79, 121, 66, 0.1);
    border-color: #4F7942;
  }
  .pillar-icon {
    display: block;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .pillar-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 0.75rem;
  }
  .pillar-desc {
    font-size: 0.875rem;
    color: #5d5d5d;
    line-height: 1.6;
    margin: 0;
  }

  /* Guru Profile */
  .guru-section { padding: 0 0 4rem; }
  .guru-header { margin-bottom: 2rem; }
  .guru-subtitle {
    text-align: center;
    color: #666;
    margin: -0.75rem 0 0;
  }
  .guru-card-container {
    max-width: 38rem;
    margin: 0 auto;
  }
  .guru-card {
    background: linear-gradient(135deg, #f4f7f3 0%, #fff 100%);
    border: 2px solid #cddbc7;
    border-radius: 20px;
    padding: 2.5rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(79, 121, 66, 0.08);
  }
  .guru-card:hover {
    border-color: #4F7942;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(79, 121, 66, 0.14);
  }
  .guru-image-box {
    width: 140px;
    height: 140px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid #4F7942;
    box-shadow: 0 4px 14px rgba(79, 121, 66, 0.2);
  }
  .guru-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .guru-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1A1A1A;
    margin: 0 0 0.5rem;
  }
  .guru-role {
    font-size: 0.875rem;
    font-weight: 700;
    color: #4F7942;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 1rem;
  }
  .guru-desc {
    font-size: 1rem;
    color: #555;
    line-height: 1.7;
    margin: 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Story */
  .story-section { padding: 0 0 4rem; }
  .story-content {
    background: #fff;
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid #e6ede3;
  }
  .story-content p {
    color: #4f4f4f;
    line-height: 1.8;
    margin: 0 0 1.25rem;
    font-size: 1rem;
  }
  .story-content strong { color: #1A1A1A; }
  .story-content a {
    color: #4F7942;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .story-content a:hover { color: #344f2e; }
  .story-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e6ede3;
  }
  .story-footer p {
    font-size: 0.875rem;
    color: #888;
  }
</style>
